{
  "name": "@screen-yield/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React + Vite + Tailwind demo app — the film browsing UI, interactive seat map, and live pricing breakdown that ties every other package together.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
