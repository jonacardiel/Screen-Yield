    "@screen-yield/schema": "*",
    "@screen-yield/snapshot": "*",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wouter": "^3.11.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
